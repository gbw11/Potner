# ============================================================
# SSAFY GMS (OpenAI 호환) 설정
# 1) 이 파일을 ".env" 로 복사했거나, 이미 .env 가 있으면 키만 채우기
# 2) GMS에서 받은 키를 OPENAI_API_KEY 에 넣기 (이름은 OpenAI지만 GMS 키 OK)
# ============================================================

# SSAFY에서 지급받은 GMS 키
OPENAI_API_KEY=

# GMS OpenAI 호환 엔드포인트 (필수)
OPENAI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1

# 저비용 테스트용 nano 모델
# 대안: gpt-5-nano (더 저렴할 수 있음), gpt-4o-mini
OPENAI_MODEL=gpt-4.1-nano

# 응답 길이 제한 (토큰 절약)
OPENAI_MAX_TOKENS=200

# Spring Boot (토양수분 POST). config backend.base_url 보다 우선
# SPRING_BASE_URL=http://127.0.0.1:8080
# DEVICE_ID=pi-01
