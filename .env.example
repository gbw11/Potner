COMPOSE_PROJECT_NAME=potner

POTNER_HTTP_PORT=80
MQTT_PORT=1883

MYSQL_DATABASE=potner
MYSQL_USER=potner_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me

SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/potner
SPRING_DATASOURCE_USERNAME=potner_app
SPRING_DATASOURCE_PASSWORD=change-me

JWT_SECRET=replace-with-base64-encoded-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRATION=1800000
JWT_REFRESH_TOKEN_EXPIRATION=1209600000

MQTT_HEALTH_USERNAME=potner-health
MQTT_HEALTH_PASSWORD=replace-with-health-password

# Backend MQTT subscriber credentials must be different from health-check credentials.
MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://mosquitto:1883
MQTT_USERNAME=potner-server
MQTT_PASSWORD=replace-with-backend-password
MQTT_CLIENT_ID=potner-backend-prod
MQTT_TOPIC=potner/device/+/sensor/telemetry
MQTT_QOS=1
MQTT_CONNECTION_TIMEOUT_SECONDS=10
MQTT_KEEP_ALIVE_SECONDS=60
MQTT_RECOVERY_INTERVAL_MS=10000

# Photo storage. Files live in the potner-photo-data named volume, not in the deploy
# directory, so deployments do not overwrite them. Nginx serves that volume publicly.
# PHOTO_BASE_URL must match the Nginx location and the public origin; there is no
# default because a wrong value silently produces unusable URLs for the app.
PHOTO_BASE_URL=http://replace-with-public-origin/media
