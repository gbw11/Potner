COMPOSE_PROJECT_NAME=potner

POTNER_HTTP_PORT=80
MQTT_PORT=1883

MYSQL_DATABASE=potner
MYSQL_USER=potner_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me

SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/potner
SPRING_DATASOURCE_USERNAME=potner_app
SPRING_DATASOURCE_PASSWORD=change-me

JWT_SECRET=replace-with-base64-encoded-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRATION=1800000
JWT_REFRESH_TOKEN_EXPIRATION=1209600000

MQTT_HEALTH_USERNAME=potner-health
MQTT_HEALTH_PASSWORD=replace-with-health-password

# Backend MQTT subscriber credentials must be different from health-check credentials.
MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://mosquitto:1883
MQTT_USERNAME=potner-server
MQTT_PASSWORD=replace-with-backend-password
MQTT_CLIENT_ID=potner-backend-prod
MQTT_TOPIC=potner/device/+/sensor/telemetry
MQTT_QOS=1
MQTT_CONNECTION_TIMEOUT_SECONDS=10
MQTT_KEEP_ALIVE_SECONDS=60
MQTT_RECOVERY_INTERVAL_MS=10000

# Arrival debug button and later Android Geofence use the same values.
# WELCOME_START reports OK when GREETING is reached, so command timeout excludes wait time.
ARRIVAL_WELCOME_WAIT_SECONDS=120
ARRIVAL_TOTAL_TIMEOUT_SECONDS=300
ARRIVAL_COMMAND_TIMEOUT_SECONDS=120
ARRIVAL_TIMEOUT_CHECK_INTERVAL_SECONDS=30

# Photo storage. Files live in the potner-photo-data named volume, not in the deploy
# directory, so deployments do not overwrite them.
#
# No variable is required here. Nginx serves the volume at /media on the same origin as
# the API, and the server returns relative URLs, so the app resolves them against its own
# API base URL. Set PHOTO_BASE_URL to an absolute URL only when photos move to a different
# origin such as a CDN.
# PHOTO_BASE_URL=https://cdn.example.com/media

# Push notifications (FCM).
#
# No variable is required here either. The pipeline reads the Firebase service account key
# from the Jenkins credential "potner-firebase-service-account" (Secret file), writes it
# into the potner-firebase-credentials named volume, and sets FIREBASE_CREDENTIALS_PATH for
# that deployment only. The key never lives in the deploy directory, which Sync Deploy
# Configs overwrites on every deployment, and never in Git.
#
# When the path is empty the application logs "Alert push runs as a no-op" and sends
# nothing. Everything else keeps working, so a missing key never blocks a deployment.
# Set this by hand only when running Compose outside the pipeline, and point it inside the
# volume mount at /var/potner/secrets.
# FIREBASE_CREDENTIALS_PATH=/var/potner/secrets/firebase-service-account.json

# Text generation (SSAFY GMS).
#
# The daily growth diary is written by an LLM. The pipeline reads the key from the Jenkins
# credential "potner-llm-api-key" (Secret text) and passes it as LLM_API_KEY for that
# deployment only, so the key never lives in Git or in the deploy directory.
#
# When LLM_API_KEY is empty the application logs "Text generation runs as a no-op" and no
# diary is written. Everything else keeps working, so a missing key never blocks a deployment.
#
# GMS is a proxy in front of the OpenAI API, so the request and response format is OpenAI's.
# The Raspberry collector uses the same endpoint. Change LLM_MODEL to trade cost for quality
# without rebuilding the image; note that o-series and gpt-5 models rename max_tokens to
# max_completion_tokens, which the client does not send.
# LLM_API_KEY=
# LLM_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini

# Growth-stage inference (YOLO, CPU).
#
# The service classifies germination / vegetative / flowering from a plant photo. It is not
# reachable from outside: compose exposes port 8000 to potner-network only, and the backend
# calls http://yolo:8000. The bundled docker-compose.yml under yolo_cpu_handoff/ publishes
# that port to the host, so do not run that file on the server.
#
# The pipeline sets YOLO_IMAGE from the git tree hash of yolo_cpu_handoff/, so the container
# is recreated only when that directory changes. Model weights are baked into the image.
#
# The container healthcheck only hits /health, which stays up even when the model fails to
# load. The deploy script and infra/scripts/health-check.sh check /ready instead, and also
# assert the three class names so swapped weights are caught.
#
# YOLO_CONFIDENCE defaults to 0.10, which is low enough to produce false positives. Tune it
# together with whatever consumes the predictions.
# YOLO_CONFIDENCE=0.10
# YOLO_IMAGE_SIZE=640
# YOLO_MAX_UPLOAD_MIB=10
# YOLO_MAX_CONCURRENCY=1
# YOLO_LOG_LEVEL=INFO
