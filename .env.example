COMPOSE_PROJECT_NAME=potner

POTNER_HTTP_PORT=80
MQTT_PORT=1883

MYSQL_DATABASE=potner
MYSQL_USER=potner_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me

SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/potner
SPRING_DATASOURCE_USERNAME=potner_app
SPRING_DATASOURCE_PASSWORD=change-me

JWT_SECRET=replace-with-base64-encoded-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRATION=1800000
JWT_REFRESH_TOKEN_EXPIRATION=1209600000

MQTT_HEALTH_USERNAME=potner-server
MQTT_HEALTH_PASSWORD=change-me
